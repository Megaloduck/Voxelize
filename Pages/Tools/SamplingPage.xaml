<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Voxelize.Pages.Tools.SamplingPage"
             Title="SamplingPage">
    
    
    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="10">

            <Button Text="Load Image"
           Command="{Binding LoadImageCommand}" />

            <Label Text="Pixel Size"/>
            <Slider Minimum="2"
           Maximum="32"
           Value="{Binding PixelSize}" />

            <Label Text="Color Depth"/>
            <Slider Minimum="2"
           Maximum="64"
           Value="{Binding ColorDepth}" />

            <Button Text="Convert"
           Command="{Binding ApplyPixelArtCommand}" />

            <Image HeightRequest="300"
          Source="{Binding PreviewImage}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>